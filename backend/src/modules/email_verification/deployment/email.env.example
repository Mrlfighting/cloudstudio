# 邮件功能上线增量模板：仅含占位及非敏感默认值，不是完整站点配置。
# 将这些字段合并到服务器已有.env；不要用本文件覆盖数据库/COS/登录等原配置。
# 替换所有REPLACE_WITH_*后，先备份迁移，再将MAIL_ENABLED改为true。
MAIL_ENABLED=false

# QQ发信邮箱与授权码：填写完整邮箱；密码使用SMTP授权码。
MAIL_SMTP_HOST=smtp.qq.com
MAIL_SMTP_PORT=465
MAIL_SMTP_USERNAME=REPLACE_WITH_QQ_EMAIL
MAIL_SMTP_PASSWORD=REPLACE_WITH_QQ_SMTP_AUTH_CODE
MAIL_SMTP_FROM=REPLACE_WITH_QQ_EMAIL
MAIL_SMTP_USE_TLS=true
MAIL_SMTP_START_TLS=false
MAIL_SMTP_ALLOW_INSECURE=false
MAIL_SMTP_TIMEOUT=20

# 两项独立密钥只在部署环境生成并妥善保存，不复用登录SECRET_KEY。
# API、dispatcher和worker必须使用同一组值，重启不得重新生成。
MAIL_TOKEN_SECRET=REPLACE_WITH_INDEPENDENT_MAIL_TOKEN_SECRET
MAIL_PAYLOAD_ENCRYPTION_KEY=REPLACE_WITH_GENERATED_FERNET_KEY

# 公开站点地址可按实际域名调整；可选联系邮箱留空时不展示。
MAIL_PUBLIC_BASE_URL=https://cloudatelier.online
MAIL_SUPPORT_EMAIL=
MAIL_QUEUE_NAME=cloudatelier.email

# 验证码有效期、重发间隔与错误次数。
MAIL_CODE_TTL_SECONDS=600
MAIL_RESEND_SECONDS=60
MAIL_CODE_MAX_ATTEMPTS=5

# 申请限流及所有邮件worker共享的发送额度。
MAIL_ACCOUNT_HOUR_LIMIT=5
MAIL_ADDRESS_HOUR_LIMIT=5
MAIL_IP_HOUR_LIMIT=20
MAIL_SEND_PER_MINUTE=10

# 数据库任务轮询与中断租约恢复，单位秒。
MAIL_POLL_SECONDS=2
MAIL_LEASE_SECONDS=120

# 共享RabbitMQ：使用服务器现有账号/密码及vhost，不新建或重置现有账号。
# Docker内使用服务名；若数据库/队列在外部，请按实际网络修改Compose覆盖项。
TASKIQ_RABBITMQ_HOST=rabbitmq
TASKIQ_RABBITMQ_PORT=5672
TASKIQ_RABBITMQ_USER=REPLACE_WITH_EXISTING_RABBITMQ_USER
TASKIQ_RABBITMQ_PASSWORD=REPLACE_WITH_EXISTING_RABBITMQ_PASSWORD
TASKIQ_RABBITMQ_VHOST=/

# 共享Redis邮件限流：沿用服务器实际配置；无认证时密码明确留空。
RATE_LIMITER_REDIS_HOST=redis
RATE_LIMITER_REDIS_PORT=6379
RATE_LIMITER_REDIS_DB=1
RATE_LIMITER_REDIS_PASSWORD=REPLACE_WITH_EXISTING_REDIS_PASSWORD_OR_LEAVE_EMPTY

# 按真实反向代理链填写整数：直连为0，不能直接信任任意X-Forwarded-For。
# 已有可靠配置时沿用原值，不因为邮件功能增加代理层数。
TRUSTED_PROXY_HOPS=REPLACE_WITH_ACTUAL_TRUSTED_PROXY_HOPS
