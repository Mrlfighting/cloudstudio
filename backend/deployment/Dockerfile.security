# 构建上下文为仓库根，完整读取 workspace 元数据，禁止构建时重新解析依赖。
FROM ghcr.io/astral-sh/uv:0.9.9 AS uv-binary

FROM python:3.11-slim AS requirements
COPY --from=uv-binary /uv /usr/local/bin/uv
WORKDIR /workspace
COPY pyproject.toml uv.lock ./
COPY backend/pyproject.toml ./backend/pyproject.toml
COPY cli/pyproject.toml ./cli/pyproject.toml
RUN uv export --offline --frozen --package fastapi-boilerplate --no-dev --no-emit-workspace \
    --output-file /tmp/requirements.txt

FROM python:3.11-slim AS base
COPY --from=uv-binary /uv /usr/local/bin/uv
WORKDIR /app
COPY --from=requirements /tmp/requirements.txt /tmp/requirements.txt
RUN --mount=type=cache,target=/root/.cache/uv \
    uv pip install --system --require-hashes -r /tmp/requirements.txt && rm /tmp/requirements.txt
COPY backend/src ./src
COPY backend/scripts ./scripts
RUN groupadd -r appuser && useradd -r -m -g appuser appuser
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1

FROM base AS migrate
COPY backend/migrations ./migrations
COPY backend/alembic.ini ./alembic.ini
USER appuser
CMD ["alembic", "upgrade", "head"]

FROM base AS prod
USER appuser
ENV WORKERS=1
CMD ["sh", "-c", "exec uvicorn src.interfaces.main:app --host 0.0.0.0 --port 8000 --workers $WORKERS --proxy-headers --forwarded-allow-ips=\"${FORWARDED_ALLOW_IPS:-127.0.0.1}\" --ws-max-size 16384 --ws-max-queue 16"]
