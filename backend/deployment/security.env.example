# 仅为上线占位示例，合并到服务器已有配置，不覆盖原有密钥。
ENVIRONMENT=production
SECRET_KEY=<EXISTING_RANDOM_SECRET_KEY>
DATABASE_URL=postgresql+asyncpg://<USER>:<PASSWORD>@<POSTGRES_HOST>:5432/<DATABASE>
CACHE_REDIS_HOST=<REDIS_HOST>
CACHE_REDIS_PASSWORD=<REDIS_PASSWORD>
RATE_LIMITER_REDIS_HOST=<REDIS_HOST>
RATE_LIMITER_REDIS_PASSWORD=<REDIS_PASSWORD>
CORS_ORIGINS=https://<PUBLIC_DOMAIN>
FORWARDED_ALLOW_IPS=<NGINX_IP_OR_PRIVATE_NETWORK_CIDR>
# 单层 Nginx 为 1；若还有 CDN，按实际可信代理链配置。
TRUSTED_PROXY_HOPS=1
SESSION_BACKEND=redis
SESSION_SECURE_COOKIES=true
CREATE_TABLES_ON_STARTUP=false
RATE_LIMITER_ENABLED=true
RATE_LIMITER_BACKEND=redis
RATE_LIMITER_FAIL_OPEN=false
DEFAULT_RATE_LIMIT_LIMIT=100
DEFAULT_RATE_LIMIT_PERIOD=60
POSTGRES_POOL_SIZE=20
POSTGRES_MAX_OVERFLOW=0
POSTGRES_POOL_TIMEOUT=5
POSTGRES_CONNECT_TIMEOUT=5
POSTGRES_COMMAND_TIMEOUT=15
WORKERS=1
